# Build outputs (the target dir lives on D:, see .cargo/config.toml)
*.exe
/target/
dist/

# Machine-local build settings (e.g. a target dir on another drive): not for other machines
/.cargo/config.toml

# Local scratch output
/scratch/

# Agent workspace files (XR-1 ruling: local-only everywhere; the harness still
# reads the working-tree copies, which stay untracked)
/AGENTS.md
/opencode.json
