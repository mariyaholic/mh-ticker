// MH Sessions - display-only MQL5 boilerplate for MH Ticker.
// @generated by `cargo run -p mh-specgen` from spec/sessions.json. Do not edit.
//
// NOT AFFILIATED WITH METAMOQUOTES. MT5 IS A METAMOQUOTES TRADEMARK.
// This indicator is strictly read-only: it contains no trading functions.
//
// Sessions are conventions, not guaranteed exchange hours. No holiday
// calendar is applied. Not financial advice.
//
// MQL5 has no general IANA database. The bounded transition tables below are
// generated from the pinned tzdb and evaluation fails visibly outside their
// coverage. Verify timer/local-clock behaviour on your terminal.
#property copyright "Made by Maria"
#property link      "https://github.com/mariyaholic/mh-ticker"
#property version   "1.00"
#property description "Display-only FX session clocks, London-New York overlap and an estimated broker reopen."
#property description "Sessions are conventions, not exchange hours. No holidays. Not financial advice."
#property description "Not affiliated with MetaQuotes; MT5 is a MetaQuotes trademark."
#property indicator_chart_window
#property indicator_plots 0

// ---------------------------------------------------------------------------
// Generated rules (from spec/sessions.json)
// ---------------------------------------------------------------------------
{{MQ5_SESSION_CONSTANTS}}
{{MQ5_CONSTANTS}}

#define MH_UNKNOWN 2147483647
#define MH_USE_MEASURED 9999

input int InpBrokerOffsetMinutes = MH_USE_MEASURED; // Broker offset override; 9999 = estimate from TimeTradeServer-TimeGMT
input bool InpBrokerRuleVerified = false;           // Check only after confirming your broker's rule
input int InpUpdateSeconds = 1;                     // Timer refresh, seconds
input color InpOpenColor = clrLime;                 // Open state
input color InpClosedColor = clrSilver;             // Closed state
input color InpWarnColor = clrOrange;               // Unknown/unverified state
input color InpDimColor = clrGray;                  // Secondary text

string MhObjectPrefix = "MH_S_";

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
int MhOffsetAt(long utc, long &at[], int &off[], int base)
{
   if(utc < MH_TABLE_FROM || utc >= MH_TABLE_TO)
      return MH_UNKNOWN;
   int n = ArraySize(at);
   int lo = 0, hi = n - 1, ans = -1;
   while(lo <= hi)
   {
      int mid = (lo + hi) / 2;
      if(at[mid] <= utc)
      {
         ans = mid;
         lo = mid + 1;
      }
      else
         hi = mid - 1;
   }
   return (ans < 0 ? base : off[ans]);
}

{{MQ5_FUNCTIONS}}

string MhOffLabel(int minutes)
{
   if(minutes == MH_UNKNOWN)
      return "unknown";
   string sign = (minutes < 0 ? "-" : "+");
   int a = (int)MathAbs(minutes);
   if(a % 60 == 0)
      return StringFormat("UTC%s%d", sign, a / 60);
   return StringFormat("UTC%s%d:%02d", sign, a / 60, a % 60);
}

bool MhCovered(long utc)
{
   return (utc >= MH_TABLE_FROM && utc < MH_TABLE_TO);
}

bool MhLocalParts(long utc, int offset, MqlDateTime &dt, int &minuteOfDay)
{
   if(offset == MH_UNKNOWN || !MhCovered(utc))
      return false;
   datetime local = (datetime)(utc + offset);
   TimeToStruct(local, dt);
   minuteOfDay = dt.hour * 60 + dt.min;
   return true;
}

string MhLocalClock(string zone, long utc)
{
   int offset = MhOffsetByZone(zone, utc);
   if(offset == MH_UNKNOWN)
      return "--:--";
   datetime local = (datetime)(utc + offset);
   MqlDateTime dt;
   TimeToStruct(local, dt);
   return StringFormat("%02d:%02d", dt.hour, dt.min);
}

bool MhSessionOpen(string zone, int openMin, int closeMin, int days, bool overnight, long utc)
{
   MqlDateTime dt;
   int minuteOfDay = 0;
   int offset = MhOffsetByZone(zone, utc);
   if(!MhLocalParts(utc, offset, dt, minuteOfDay))
      return false;
   int idx = (dt.day_of_week + 6) % 7; // Monday-first
   bool today = (((days >> idx) & 1) != 0);
   if(!overnight)
      return (today && minuteOfDay >= openMin && minuteOfDay < closeMin);
   if(today && minuteOfDay >= openMin)
      return true;
   int prev = (idx + 6) % 7;
   bool yesterday = (((days >> prev) & 1) != 0);
   return (yesterday && minuteOfDay < closeMin);
}

long MhLocalToUtc(string zone, datetime local)
{
   long guess = (long)local;
   for(int i = 0; i < 3; i++)
   {
      int off = MhOffsetByZone(zone, guess);
      if(off == MH_UNKNOWN)
         return 0;
      guess = (long)local - off;
   }
   if(MhOffsetByZone(zone, guess) == MH_UNKNOWN)
      return 0;
   return guess;
}

long MhNextBoundary(string zone, int openMin, int closeMin, int days, bool overnight, long utc)
{
   int offset = MhOffsetByZone(zone, utc);
   if(offset == MH_UNKNOWN)
      return 0;
   datetime localNow = (datetime)(utc + offset);
   MqlDateTime dt;
   TimeToStruct(localNow, dt);
   datetime midnight = StructToTime(dt);
   long best = 0;
   for(int d = -1; d <= 10; d++)
   {
      datetime localOpen = midnight + d * 86400 + openMin * 60;
      datetime localClose = midnight + d * 86400 + closeMin * 60 + (closeMin <= openMin ? 86400 : 0);
      MqlDateTime odt;
      TimeToStruct(localOpen, odt);
      int idx = (odt.day_of_week + 6) % 7;
      if(((days >> idx) & 1) == 0)
         continue;
      long openUtc = MhLocalToUtc(zone, localOpen);
      long closeUtc = MhLocalToUtc(zone, localClose);
      if(openUtc > utc && (best == 0 || openUtc < best))
         best = openUtc;
      if(closeUtc > utc && (best == 0 || closeUtc < best))
         best = closeUtc;
   }
   return best;
}

int MhBrokerOffsetAt(long utc)
{
   if(!MH_BROKER_US_DST)
      return MH_BROKER_WINTER_OFFSET;
   int ny = MhOffsetByZone("America/New_York", utc);
   if(ny == MH_UNKNOWN)
      return MH_BROKER_WINTER_OFFSET;
   return (ny == -14400 ? MH_BROKER_SUMMER_OFFSET : MH_BROKER_WINTER_OFFSET);
}

long MhBrokerNextReopen(long utc)
{
   if(!InpBrokerRuleVerified)
      return 0;
   int offset = MhBrokerOffsetAt(utc);
   datetime localNow = (datetime)(utc + offset * 60);
   MqlDateTime dt;
   TimeToStruct(localNow, dt);
   datetime midnight = StructToTime(dt);
   long best = 0;
   for(int d = -1; d <= 10; d++)
   {
      datetime localReopen = midnight + d * 86400 + MH_BROKER_REOPEN * 60;
      MqlDateTime rdt;
      TimeToStruct(localReopen, rdt);
      int idx = (rdt.day_of_week + 6) % 7;
      if(((MH_BROKER_DAYS >> idx) & 1) == 0)
         continue;
      long guess = (long)localReopen;
      for(int i = 0; i < 3; i++)
         guess = (long)localReopen - (long)MhBrokerOffsetAt(guess) * 60;
      if(guess > utc && (best == 0 || guess < best))
         best = guess;
   }
   return best;
}

string MhDuration(long seconds)
{
   if(seconds <= 0)
      return "now";
   long mins = seconds / 60;
   if(mins < 1)
      return StringFormat("%ds", (int)seconds);
   if(mins < 60)
      return StringFormat("%dm", (int)mins);
   long hours = mins / 60;
   if(hours < 24)
      return StringFormat("%dh %02dm", (int)hours, (int)(mins % 60));
   return StringFormat("%dd %dh", (int)(hours / 24), (int)(hours % 24));
}

string MhSessionLine(string title, string zone, int openMin, int closeMin, int days, bool overnight, long utc)
{
   int offset = MhOffsetByZone(zone, utc);
   if(offset == MH_UNKNOWN || !MhCovered(utc))
      return StringFormat("%-9s %5s  %-6s %s", title, "--:--", "unknown", "outside tzdb table");
   bool open = MhSessionOpen(zone, openMin, closeMin, days, overnight, utc);
   long next = MhNextBoundary(zone, openMin, closeMin, days, overnight, utc);
   string detail = (next == 0 ? "no transition" : (open ? "closes in " : "opens in ") + MhDuration(next - utc));
   return StringFormat("%-9s %5s  %-6s %s", title, MhLocalClock(zone, utc), open ? "open" : "closed", detail);
}

void MhLabel(string name, string text, int row, color clr, int size = 9)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_RIGHT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_XDISTANCE, 330);
      ObjectSetString(0, name, OBJPROP_FONT, "Consolas");
      ObjectSetInteger(0, name, OBJPROP_FONTSIZE, size);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
   }
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, 18 + row * 16);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
}

void MhUpdate()
{
   long utc = (long)TimeGMT();
   if(utc <= 0)
   {
      MhLabel(MhObjectPrefix + "0", "MH Sessions: UTC clock unavailable", 0, InpWarnColor, 9);
      ChartRedraw();
      return;
   }

   string sydney = MhSessionLine("SYDNEY", MH_ZONE_SYDNEY, MH_OPEN_SYDNEY, MH_CLOSE_SYDNEY, MH_DAYS_SYDNEY, MH_OVERNIGHT_SYDNEY, utc);
   string tokyo = MhSessionLine("TOKYO", MH_ZONE_TOKYO, MH_OPEN_TOKYO, MH_CLOSE_TOKYO, MH_DAYS_TOKYO, MH_OVERNIGHT_TOKYO, utc);
   string london = MhSessionLine("LONDON", MH_ZONE_LONDON, MH_OPEN_LONDON, MH_CLOSE_LONDON, MH_DAYS_LONDON, MH_OVERNIGHT_LONDON, utc);
   string newYork = MhSessionLine("NEW YORK", MH_ZONE_NEW_YORK, MH_OPEN_NEW_YORK, MH_CLOSE_NEW_YORK, MH_DAYS_NEW_YORK, MH_OVERNIGHT_NEW_YORK, utc);
   bool overlap = MhSessionOpen(MH_ZONE_LONDON, MH_OPEN_LONDON, MH_CLOSE_LONDON, MH_DAYS_LONDON, MH_OVERNIGHT_LONDON, utc)
                  && MhSessionOpen(MH_ZONE_NEW_YORK, MH_OPEN_NEW_YORK, MH_CLOSE_NEW_YORK, MH_DAYS_NEW_YORK, MH_OVERNIGHT_NEW_YORK, utc);
   string overlapLine = StringFormat("%-9s %5s  %-6s %s", "OVERLAP", "LON-NY", overlap ? "open" : "closed", "intersection in UTC");

   int brokerOffset = InpBrokerOffsetMinutes;
   bool measured = false;
   bool connected = (bool)TerminalInfoInteger(TERMINAL_CONNECTED);
   long serverDiff = (long)TimeTradeServer() - (long)TimeGMT();
   if(brokerOffset == MH_USE_MEASURED)
   {
      if(MathAbs(serverDiff) > 14 * 3600)
         brokerOffset = MH_UNKNOWN;
      else
      {
         brokerOffset = (int)MathRound(serverDiff / 60.0);
         measured = true;
      }
   }
   string brokerClock = "--:--";
   string brokerState = "unknown";
   string brokerDetail = "server clock unreliable";
   if(brokerOffset != MH_UNKNOWN)
   {
      brokerClock = TimeToString((datetime)(utc + brokerOffset * 60), TIME_MINUTES);
      brokerState = MhOffLabel(brokerOffset) + (measured ? " est" : " set");
      long reopen = MhBrokerNextReopen(utc);
      if(!InpBrokerRuleVerified)
         brokerDetail = "reopen unknown (rule unverified)";
      else if(reopen == 0)
         brokerDetail = "reopen unknown";
      else
         brokerDetail = "reopens in " + MhDuration(reopen - utc);
   }
   if(!connected)
   {
      brokerState = "unknown";
      brokerDetail = "unknown (terminal disconnected)";
   }
   string brokerLine = StringFormat("%-9s %5s  %-8s %s", "BROKER", brokerClock, brokerState, brokerDetail);

   long deviceDiff = (long)TimeLocal() - (long)TimeGMT();
   string deviceClock = "--:--";
   string deviceState = "unavailable";
   string deviceDetail = "TimeLocal/TimeGMT unreliable";
   if(MathAbs(deviceDiff) <= 18 * 3600)
   {
      deviceClock = TimeToString(TimeLocal(), TIME_MINUTES);
      deviceState = MhOffLabel((int)MathRound(deviceDiff / 60.0));
      deviceDetail = MQLInfoInteger(MQL_TESTER) ? "tester local clock" : "TimeLocal, not auto-mapped";
   }
   string deviceLine = StringFormat("%-9s %5s  %-8s %s", "DEVICE", deviceClock, deviceState, deviceDetail);

   long tickAge = (long)TimeTradeServer() - (long)TimeCurrent();
   if(tickAge < 0)
      tickAge = 0;
   string status = StringFormat("%s | tick age %s | spec %s | tzdb %s",
                                connected ? "connected" : "DISCONNECTED",
                                MhDuration(tickAge), MH_SPEC_VERSION, MH_TZDB_VERSION);
   string caveat = "Conventions, not exchange hours | no holidays | broker offset is an estimate";

   MhLabel(MhObjectPrefix + "0", "MH Sessions", 0, InpClosedColor, 10);
   MhLabel(MhObjectPrefix + "1", sydney, 1, InpClosedColor);
   MhLabel(MhObjectPrefix + "2", tokyo, 2, InpClosedColor);
   MhLabel(MhObjectPrefix + "3", london, 3, InpClosedColor);
   MhLabel(MhObjectPrefix + "4", newYork, 4, InpClosedColor);
   MhLabel(MhObjectPrefix + "5", overlapLine, 5, overlap ? InpOpenColor : InpDimColor);
   MhLabel(MhObjectPrefix + "6", brokerLine, 6, InpBrokerRuleVerified ? InpClosedColor : InpWarnColor);
   MhLabel(MhObjectPrefix + "7", deviceLine, 7, MQLInfoInteger(MQL_TESTER) ? InpWarnColor : InpDimColor);
   MhLabel(MhObjectPrefix + "8", caveat, 8, InpDimColor, 8);
   MhLabel(MhObjectPrefix + "9", status, 9, InpDimColor, 8);
   ChartRedraw();
}

int OnInit()
{
   if(InpUpdateSeconds < 1)
      return INIT_PARAMETERS_INCORRECT;
   EventSetTimer(InpUpdateSeconds);
   MhUpdate();
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   EventKillTimer();
   ObjectsDeleteAll(0, MhObjectPrefix);
}

int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   MhUpdate();
   return rates_total;
}

void OnTimer()
{
   MhUpdate();
}
