//@version=6
// SPDX-License-Identifier: MIT
// MH Sessions — a display-only TradingView Pine v6 boilerplate for MH Ticker.
// @generated by `cargo run -p mh-specgen` from spec/sessions.json. Do not edit.
//
// NOT AFFILIATED WITH TRADINGVIEW.
//
// Pine cannot read the chart or device time zone. `syminfo.timezone` is the
// symbol's exchange zone, not the chart or device zone. The one extra clock is
// therefore a MANUAL input.string IANA setting; it is never auto-detected.
// Session membership is evaluated with `time(timeframe.period, session, zone)`,
// so the chart timeframe affects the granularity and the table updates on bar
// events, not on a wall clock. There are no session countdowns in this
// boilerplate; the native ticker panel is the accurate countdown surface.
//
// Sessions are conventions, not guaranteed exchange hours. No holiday calendar
// is applied. Not financial advice.

indicator("MH Sessions (MH Ticker)", overlay = false, max_labels_count = 0, max_lines_count = 0)

// ---------------------------------------------------------------------------
// Generated rules (from spec/sessions.json)
// ---------------------------------------------------------------------------
{{PINE_SESSION_CONSTANTS}}
{{PINE_CONSTANTS}}

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
// The manual extra clock. Default syminfo.timezone is only a starting point:
// it is the exchange zone, not your chart or device zone. Pick your own zone.
string extraZone = input.string(
     defval = syminfo.timezone,
     title = "Extra clock: set to your chart/device zone (manual IANA, not auto-detected)",
     options = [
         "UTC", "Etc/UTC", "America/New_York", "America/Chicago", "America/Denver",
         "America/Los_Angeles", "America/Toronto", "America/Sao_Paulo",
         "Europe/London", "Europe/Dublin", "Europe/Lisbon", "Europe/Paris",
         "Europe/Berlin", "Europe/Madrid", "Europe/Rome", "Europe/Zurich",
         "Europe/Warsaw", "Europe/Athens", "Europe/Istanbul", "Europe/Moscow",
         "Africa/Johannesburg", "Africa/Cairo", "Africa/Lagos", "Africa/Nairobi",
         "Asia/Dubai", "Asia/Riyadh", "Asia/Tehran", "Asia/Karachi",
         "Asia/Kolkata", "Asia/Dhaka", "Asia/Bangkok", "Asia/Shanghai",
         "Asia/Hong_Kong", "Asia/Singapore", "Asia/Tokyo", "Asia/Seoul",
         "Australia/Perth", "Australia/Adelaide", "Australia/Brisbane",
         "Australia/Sydney", "Australia/Hobart", "Pacific/Auckland"
     ])
int brokerOffset = input.int(
     defval = MH_BROKER_OFFSET_MIN,
     title = "Broker UTC offset (minutes, estimate — not a live feed)",
     minval = -720,
     maxval = 840)
bool showTable = input.bool(defval = true, title = "Show the sessions table")

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
f_duration(int ms) =>
    int mins = int(math.floor((ms < 0 ? 0 : ms) / 60000))
    int d = int(mins / 1440)
    int h = int((mins % 1440) / 60)
    int m = mins % 60
    d > 0 ? str.tostring(d) + "d " + str.tostring(h) + "h" : h > 0 ? str.tostring(h) + "h " + str.tostring(m) + "m" : str.tostring(m) + "m"

f_off_label(int minutes) =>
    string sign = minutes < 0 ? "-" : "+"
    int a = minutes < 0 ? -minutes : minutes
    string hh = str.tostring(int(a / 60))
    string mm = a % 60 == 0 ? "" : ":" + (a % 60 < 10 ? "0" : "") + str.tostring(a % 60)
    "UTC" + sign + hh + mm

// Next occurrence of a weekly wall-clock rule (Pine day: 1=Sunday .. 7=Saturday).
f_next_weekly(int now, int minuteOfDay, int pineDay) =>
    int dow = dayofweek(now, "UTC")
    int addDays = int((pineDay - dow + 7) % 7)
    int base = timestamp("UTC", year(now, "UTC"), month(now, "UTC"), dayofmonth(now, "UTC"), 0, 0, 0)
    int candidate = base + addDays * 86400000 + minuteOfDay * 60000
    candidate <= now ? candidate + 7 * 86400000 : candidate

// ---------------------------------------------------------------------------
// Table
// ---------------------------------------------------------------------------
var table t = table.new(position.top_right, 4, 10, frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 80), border_width = 1)

if showTable and barstate.islast
    string sydney = not na(time(timeframe.period, MH_SESSION_SYDNEY, MH_ZONE_SYDNEY)) ? "open" : "closed"
    string tokyo = not na(time(timeframe.period, MH_SESSION_TOKYO, MH_ZONE_TOKYO)) ? "open" : "closed"
    string london = not na(time(timeframe.period, MH_SESSION_LONDON, MH_ZONE_LONDON)) ? "open" : "closed"
    string newYork = not na(time(timeframe.period, MH_SESSION_NEW_YORK, MH_ZONE_NEW_YORK)) ? "open" : "closed"
    bool overlapOpen = london == "open" and newYork == "open"

    int reopenAt = f_next_weekly(timenow, MH_BROKER_REOPEN_MIN, MH_BROKER_REOPEN_DAY)
    string brokerClock = str.format_time(timenow + brokerOffset * 60000, "HH:mm", "UTC")
    string brokerDetail = MH_BROKER_VERIFIED ? "reopen in " + f_duration(reopenAt - timenow) : "unknown (unverified rule) · est " + str.format_time(reopenAt, "EEE HH:mm", "UTC")
    string extraClock = str.format_time(timenow, "HH:mm", extraZone)

    color openColor = color.new(color.green, 0)
    color closedColor = color.new(color.gray, 30)
    color dimColor = color.new(color.gray, 20)
    color headColor = color.new(color.white, 0)

    table.cell(t, 0, 0, "MH Sessions", text_color = headColor, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 0, "UTC " + str.format_time(timenow, "HH:mm:ss", "UTC"), text_color = dimColor, text_size = size.tiny)
    table.cell(t, 2, 0, "spec " + MH_SPEC_VERSION, text_color = dimColor, text_size = size.tiny)
    table.cell(t, 3, 0, "tzdb " + MH_TZDB_VERSION, text_color = dimColor, text_size = size.tiny)

    table.cell(t, 0, 1, "Session", text_color = dimColor, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 1, "Clock", text_color = dimColor, text_size = size.tiny)
    table.cell(t, 2, 1, "State", text_color = dimColor, text_size = size.tiny)
    table.cell(t, 3, 1, "Local window", text_color = dimColor, text_size = size.tiny)

    table.cell(t, 0, 2, "Sydney", text_color = headColor, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 2, str.format_time(timenow, "HH:mm", MH_ZONE_SYDNEY), text_color = headColor, text_size = size.small)
    table.cell(t, 2, 2, sydney, text_color = sydney == "open" ? openColor : closedColor, text_size = size.small)
    table.cell(t, 3, 2, MH_WINDOW_SYDNEY, text_color = dimColor, text_size = size.tiny)

    table.cell(t, 0, 3, "Tokyo", text_color = headColor, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 3, str.format_time(timenow, "HH:mm", MH_ZONE_TOKYO), text_color = headColor, text_size = size.small)
    table.cell(t, 2, 3, tokyo, text_color = tokyo == "open" ? openColor : closedColor, text_size = size.small)
    table.cell(t, 3, 3, MH_WINDOW_TOKYO, text_color = dimColor, text_size = size.tiny)

    table.cell(t, 0, 4, "London", text_color = headColor, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 4, str.format_time(timenow, "HH:mm", MH_ZONE_LONDON), text_color = headColor, text_size = size.small)
    table.cell(t, 2, 4, london, text_color = london == "open" ? openColor : closedColor, text_size = size.small)
    table.cell(t, 3, 4, MH_WINDOW_LONDON, text_color = dimColor, text_size = size.tiny)

    table.cell(t, 0, 5, "New York", text_color = headColor, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 5, str.format_time(timenow, "HH:mm", MH_ZONE_NEW_YORK), text_color = headColor, text_size = size.small)
    table.cell(t, 2, 5, newYork, text_color = newYork == "open" ? openColor : closedColor, text_size = size.small)
    table.cell(t, 3, 5, MH_WINDOW_NEW_YORK, text_color = dimColor, text_size = size.tiny)

    table.cell(t, 0, 6, "London–New York overlap", text_color = headColor, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 6, "", text_color = dimColor, text_size = size.tiny)
    table.cell(t, 2, 6, overlapOpen ? "open" : "closed", text_color = overlapOpen ? openColor : closedColor, text_size = size.small)
    table.cell(t, 3, 6, "intersection in UTC", text_color = dimColor, text_size = size.tiny)

    table.cell(t, 0, 7, "Broker", text_color = headColor, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 7, brokerClock, text_color = headColor, text_size = size.small)
    table.cell(t, 2, 7, f_off_label(brokerOffset), text_color = dimColor, text_size = size.small)
    table.cell(t, 3, 7, brokerDetail, text_color = MH_BROKER_VERIFIED ? closedColor : color.new(color.orange, 0), text_size = size.tiny)

    table.cell(t, 0, 8, "Extra clock (manual)", text_color = headColor, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, 8, extraClock, text_color = headColor, text_size = size.small)
    table.cell(t, 2, 8, extraZone, text_color = dimColor, text_size = size.tiny)
    table.cell(t, 3, 8, "not auto-detected", text_color = color.new(color.orange, 0), text_size = size.tiny)

    table.cell(t, 0, 9, "Conventions, not exchange hours · no holidays · updates on bar events", text_color = dimColor, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, 9, "", text_color = dimColor, text_size = size.tiny)
    table.cell(t, 2, 9, "", text_color = dimColor, text_size = size.tiny)
    table.cell(t, 3, 9, "last bar " + str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + " UTC", text_color = dimColor, text_size = size.tiny)
